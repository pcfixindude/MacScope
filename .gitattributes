# Default
* text=auto eol=lf

# Explicit text types
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.command text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf
VERSION text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Scripts marked executable in the index when present
*.sh text eol=lf
MacScope.command text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary

# Archives / packages
*.whl binary
*.egg binary
